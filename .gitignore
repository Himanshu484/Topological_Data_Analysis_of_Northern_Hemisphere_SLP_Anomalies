# Data: raw downloads and derived feature files are not tracked (about 17 GB; see data/README.md).
# The small diagnostics of each surrogate (diag_*.json) are tracked, because the tables read them.
/data/raw/
/data/processed_data/*
!/data/processed_data/experiments/
/data/processed_data/experiments/*/*
!/data/processed_data/experiments/*/diag_*.json

# Results: the summaries in output/ are tracked (every table of the paper is built from them);
# per-realisation caches and regenerated intermediates are not.
/output/**/cache/
/output/paper/null_tables/

# Tables and figures written when no manuscript folder is present (scripts/paper/paths.py)
/paper_outputs/

# Build products
__pycache__/
*.py[cod]
*.so
.pytest_cache/
logs/

# Environments
.venv/
venv/
env/

# Julia
Manifest.toml

# OS
.DS_Store
